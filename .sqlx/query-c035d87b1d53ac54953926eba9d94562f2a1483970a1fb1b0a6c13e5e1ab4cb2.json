  "query": "SELECT seq, entity_personality_instance_id, wake_chain_depth\n             FROM proxima_core.change_event\n             WHERE owner_principal_kind = $1\n               AND owner_principal_id = $2\n               AND owner_org_id = $3\n               AND seq > $4\n               AND ($5::uuid IS NULL OR seq <= $5)\n             ORDER BY seq ASC\n             LIMIT $6",
