  "query": "SELECT edge_id,\n                  target_kind AS \"target_kind: EntityKind\",\n                  target_memory_id,\n                  target_goal_id\n             FROM proxima_core.edges\n             WHERE relation = $1\n               AND source_goal_id = $2\n               AND owner_principal_kind = $3\n               AND owner_principal_id = $4\n             ORDER BY created_at ASC",
