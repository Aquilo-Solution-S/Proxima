# Local desktop-shell config. Copy to `.env` (gitignored) and edit.
# The Rust side loads this via dotenvy::dotenv() at the top of run().

# Postgres connection. The desktop shell requires this to be set —
# settings persistence relies on the DB tables created by storage-pg
# migrations. Default matches `docker-compose.dev.yml`.
DATABASE_URL=postgres://proxima:proxima@127.0.0.1:5432/proxima

# Local S3-compatible object storage. `tauri:dev` starts MinIO from
# `docker-compose.dev.yml` and creates this bucket.
PROXIMA_S3_BUCKET=proxima-dev
PROXIMA_S3_REGION=us-east-1
PROXIMA_S3_ENDPOINT_URL=http://127.0.0.1:9100
PROXIMA_S3_FORCE_PATH_STYLE=true
PROXIMA_S3_UPLOAD_TTL_SECONDS=900
PROXIMA_S3_READ_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=proxima
AWS_SECRET_ACCESS_KEY=proxima-dev
AWS_REGION=us-east-1

# Optional: tracing filter. See tracing_subscriber::EnvFilter docs.
# RUST_LOG=info,proxima_shell=debug,proxima_storage_pg=debug
